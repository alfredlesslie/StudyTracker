# StudySense AI - Environment Configuration Example
# Copy this file to .env and configure for your environment.

# Database URL Configuration
# Default for local development: SQLite (works immediately without any external database)
DATABASE_URL=sqlite:///./studysense.db

# Production PostgreSQL configuration example:
# DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/studysense_db

# Application Settings
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
PROTOTYPE_STUDENT_ID=student-001

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Frontend API Configuration
VITE_API_BASE_URL=http://127.0.0.1:8000

